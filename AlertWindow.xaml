<Window x:Class="Lembretes.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lembrete" Width="350" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Border x:Name="Frame" Margin="12" CornerRadius="10" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="14,8,8,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE8BB;"
                        Tag="close" Click="OnAction" ToolTip="Fechar aviso"/>
                <TextBlock x:Name="HeaderIcon" Text="&#xE7ED;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderText" Text="Lembrete" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TimeText" Margin="8,0,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel x:Name="TagRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                <Ellipse x:Name="TagDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,5,0"/>
                <TextBlock x:Name="TagText" FontSize="11"/>
            </StackPanel>
            <TextBlock x:Name="Msg" Margin="0,4,8,12" FontSize="15" TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}" Cursor="Hand"
                       MouseLeftButtonUp="OnMsgClick" ToolTip="Abrir a lista de lembretes"/>
            <DockPanel Margin="0,0,6,0">
                <Button x:Name="DoneBtn" DockPanel.Dock="Right" Style="{StaticResource AccentTextBtn}" Content="Concluído"
                        Tag="done" Click="OnAction" VerticalAlignment="Top"/>
                <WrapPanel x:Name="SnoozePanel" VerticalAlignment="Center">
                    <TextBlock Text="Adiar:" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,4"/>
                    <Button Style="{StaticResource Chip}" Content="5 min" Tag="5" Click="OnAction"/>
                    <Button Style="{StaticResource Chip}" Content="15 min" Tag="15" Click="OnAction"/>
                    <Button Style="{StaticResource Chip}" Content="1 h" Tag="60" Click="OnAction"/>
                </WrapPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
